{
  "_comment": "TubeNews Configuration Template. See CLAUDE.md for full documentation.",

  "gemini_api_key": "ADD-GEMINI-KEY",
  "gemini_model": "gemini-2.5-flash",
  "websub_post_timeout": 30,
  "supadata_api_key": "ADD-SUPADATA-KEY",
  "_comment_transcript_mode": "native = existing captions only (1 credit). auto/generate fall back to speech-to-text, which is BILLED BY VIDEO LENGTH — a multi-hour meeting can cost >1400 credits.",
  "supadata_transcript_mode": "native",
  "supadata_http_timeout": 120,
  "_comment_daily": "The daily cap is derived: (remaining this cycle / days left) * pace_safety, times burst_factor. Tight early in a cycle, generous late when credits would otherwise expire. supadata_daily_limit is an OPTIONAL absolute override for 'never more than this whatever the arithmetic says' — leave it out unless you need one; setting it near the nominal daily spend defeats the pacing.",
  "_comment_monthly": "The cycle budget is taken from the plan size Supadata itself reports (maxCredits), so a plan change is picked up automatically. supadata_monthly_limit is an OPTIONAL override meaning 'spend no more than this much of my plan' — LEAVE IT OUT unless you want that, because a hardcoded number cannot track a plan that changes on the vendor's side.",
  "supadata_dynamic_daily": true,
  "supadata_pace_safety_factor": 0.9,
  "supadata_daily_burst_factor": 2.0,
  "supadata_balance_refresh_hours": 24,
  "supadata_billing_cycle_day": 1,
  "max_video_age_days": 14,

  "content_dir": "",
  "state_dir": "",

  "request_timeout": 15,
  "gemini_call_delay": 8,
  "max_parallel_feeds": 1,

  "base_url": "",

  "port": 8000,
  "tubenews_key": "generate with: python -c 'import secrets; print(secrets.token_hex(32))'",
  "admin_users": ["you@example.com"],

  "ntfy_topic": "TubeNewsAdmin",

  "resend_api_key": "",
  "resend_from_email": "TubeNews <digest@yourdomain.com>",
  "email_digest_send_hour": 7,

  "_comment_tts": "Daily audio podcast. Empty tts_api_key disables the feature entirely. For 'google' this is a Google Cloud Text-to-Speech key (NOT a Gemini key) — Cloud TTS has a perpetual monthly free allowance (4M chars Standard, 1M Neural2) and one user costs ~225k chars/month, but billing must be enabled and overage auto-charges, so set a cloud budget alert. Scripts are split automatically to each vendor's per-request input cap.",
  "tts_provider": "google",
  "tts_api_key": "",
  "tts_voice_id": "en-US-Neural2-J",
  "tts_language_code": "en-US",
  "podcast_generation_hour": 6,
  "podcast_retention_days": 7,

  "websub_callback_url": "https://yourdomain.com/youtube/push",
  "websub_secret": "generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'",
  "websub_daemon_port": 8675,
  "websub_check_interval_minutes": 1,
  "websub_max_videos_per_cycle": 3
}
